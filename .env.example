# Cloud SQL (PostgreSQL) Runtime Connection Variables
SQL_HOST="127.0.0.1"
SQL_DB_NAME="hackforge"
SQL_USER="hackforge_app"
SQL_PASSWORD="change_me"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Authentication & Security
JWT_SECRET="replace_with_64_char_random_secret"
JWT_REFRESH_SECRET="replace_with_64_char_random_refresh_secret"

# Application URLs & CORS
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Gemini API (injected automatically in AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
